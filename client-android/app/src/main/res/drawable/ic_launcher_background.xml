<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer of the adaptive icon: a plain dark field, so the red
  dot on top reads as an emergency button rather than as a flat red tile.
  Must fill the whole 108x108dp canvas: the launcher can shift this layer
  a few dp for parallax, and any gap would show as a hard edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#201A1A"
        android:pathData="M0,0h108v108h-108z" />
</vector>
