<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: the launcher supplies the mask (round on Pixel, squircle
  on Samsung, and so on) and clips both layers to it. minSdk is 26, which
  is exactly when adaptive icons arrived, so no legacy PNG fallback is
  needed anywhere.

  Monochrome is declared as well: on Android 13+ with themed icons turned
  on, the launcher tints that layer to match the wallpaper instead of
  using the colour version. Without it the icon simply stays red there,
  which is fine too, but this way it behaves like a first-class app.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
