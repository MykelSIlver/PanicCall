# Never commit real tokens
pairs.json

# Never commit signing keys (once release builds exist)
*.jks
*.keystore
key.properties

__pycache__/
*.pyc
server.log

# Sailfish build artifacts
client/RPMS/
client/*.o
client/moc_*.cpp
client/Makefile
client/harbour-paniccall
client/.qmake.stash

# Android build artifacts
client-android/.gradle/
client-android/.idea/
client-android/local.properties
client-android/app/build/
client-android/build/
client-android/**/build/
client-android/.kotlin/
client-android/**/.cxx/
client-android/**/*.iml
client-android/captures/

# A locally-built APK someone grabbed by hand (e.g. to send to a
# colleague) should never end up committed, wherever it's copied to.
*.apk
*.aab
